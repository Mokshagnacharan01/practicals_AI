print("Hello! I am ROBOT") 
print("Today we will build a cleaning Robot together.") 
print(“We will Clean the dirty spots in Room ! “) 
 
 
# Room: D = Dirty, C = Clean 
room = ["D", "C", "D", "D", "C"] 
 
 
# Function to display the room 
def show_room(room): 
    picture = "" 
 
    for spot in room: 
        if spot == "D": 
            picture += "dirty " 
        else: 
            picture += "clean " 
 
    print(picture) 
 
 
print("Our room right now:") 
show_room(room) 
 
 
# Function to clean a spot 
def clean_spot(spot): 
    if spot == "D": 
        return "C" 
    else: 
        return "C"
 
# Test the cleaning function 
result = clean_spot("D") 
 
 
 
print( 
    "The robot looked at the dirty spot and made it:", 
    result, 
    "(c means clean)" 
) 
 
 
print("\nBefore - the dirty room:") 
show_room(room) 
 
 
# Clean every spot in the room 
for i in range(len(room)): 
    room[i] = clean_spot(room[i]) 
 
 
    print("After cleaning spot number", i + 1, ":") 
    show_room(room) 
    print() 
 
 
 
print("After - all done!")
